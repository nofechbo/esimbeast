generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlanOrder {
  id           Int      @id @default(autoincrement())
  orderId      String
  email        String
  orderTime    DateTime
  qrLink       String?
  lpa          String?
  price        Decimal
  countryCodes String[]
  data         Decimal
  duration     Int
  productId    String
  productName  String
  rcode        String?

  @@index([orderId])
}

model Plan {
  id           Int      @id @default(autoincrement())
  productId    String
  code         String
  name         String
  days         Int
  limited      Boolean
  fup          String  // this is the string representation of the data, e.g., "5 GB"
  data         Decimal // data in GB
  dailyDataCap String? // string as it can say "max"
  reducedSpeed Int
  price        Decimal //make sure it's 'Sell Price', and not 'cost'!
  reloadable   Boolean
  countryCodes String[]
  networks     String[]
  networkSpeed String?
  apn          String?
  hotspot      String?
  activation   String?
  delivery     String?
  seoText      String? //"Your Plan Summary" in sheets
  planType     String?
  localNumber  String?
  eKYC         Boolean? //NOT CURRENTLY IN NEW SHEET!
  uniqueName   String   @unique
  isPopular    Boolean  @default(false)

  @@index([productId])
  @@index([countryCodes], type: Gin)
  @@index([uniqueName])
}
