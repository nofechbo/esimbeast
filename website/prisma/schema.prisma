generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlanOrder {
  id           Int      @id @default(autoincrement())
  orderId      String
  email        String
  orderTime    DateTime
  qrLink       String?
  lpa          String?
  price        Decimal
  countryCodes String[]
  data         Decimal
  duration     Int
  productId    String
  productName  String

  @@index([orderId])
}

model Plan {
  id           Int      @id @default(autoincrement())
  productId    String
  code         String
  name         String
  days         Int
  limited      Boolean
  fup          String
  data         Decimal
  reducedSpeed Int
  price        Decimal
  reloadable   Boolean
  countryCodes String[]
  ipRoute      String?
  operators    String[] @default([])
  apn          String?
  salePrice    Decimal?
  uniqueName   String   @unique
  isPopular    Boolean  @default(false)

  @@index([productId])
  @@index([countryCodes], type: Gin)
  @@index([uniqueName])
}
