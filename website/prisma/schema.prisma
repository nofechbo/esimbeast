generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlanOrder {
  id           Int      @id @default(autoincrement())
  intentId     String
  orderId      String? //will be null until after successful payment
  email        String
  orderTime    DateTime
  qrLink       String?
  lpa          String?
  price        Decimal
  countryCodes String[]
  data         Decimal
  duration     Int
  productId    String
  productName  String
  rcode        String?

  @@index([intentId])
  @@index([orderId])
}

model Plan {
  id           Int      @id @default(autoincrement())
  productId    String
  code         String
  name         String
  days         Int
  limited      Boolean
  fup          String
  data         Decimal //note - in new sheet -> all in gb. so mb is 0.5gb for example. but some places it says 3gb/day
  reducedSpeed Int
  price        Decimal //make sure it's 'Sell Price', and not 'cost'!
  reloadable   Boolean
  countryCodes String[]
  ipRoute      String?
  operators    String[] @default([])
  apn          String?
  salePrice    Decimal?
  uniqueName   String   @unique
  isPopular    Boolean  @default(false)

  //from new sheet 
  //optional for now -> make NOT-OPTIONAL later!
  SEOText      String? //"Your Plan Summary" in sheets
  Activation   String?
  Networks     String?
  NetworkSpeed String?
  PlanType     String?
  HotSpot      Boolean?
  LocalNumber  Boolean?
  Delivery     String?
  eKYC         Boolean? //NOT CURRENTLY IN NEW SHEET!

  @@index([productId])
  @@index([countryCodes], type: Gin)
  @@index([uniqueName])
}
